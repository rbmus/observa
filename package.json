{
  "name": "observa",
  "version": "1.0.5",
  "description": "OBSERVA — система мониторинга цен конкурентов 24/7",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev": "npm run electron:dev",
    "vite": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts": "^7.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.observa.app",
    "productName": "OBSERVA",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rbmus",
        "repo": "observa"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "icon-app.png",
        "to": "icon-app.png"
      }
    ],
    "mac": {
      "icon": "icon-app.icns"
    },
    "win": {
      "icon": "icon-app.png"
    }
  }
}
